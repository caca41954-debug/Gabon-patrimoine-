# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# MOBILE MONEY PROVIDERS (GABON — BILLING EASY / SHAP)
# Configurez ces variables dans AI Studio -> Settings -> Secrets avant d'activer les paiements automatiques.
SHAP_API_ID=
SHAP_API_SECRET=
SHAP_BASE_URL=https://test.billing-easy.net/shap/api/v1
SHAP_WEBHOOK_SECRET=

EBILLING_BASE_URL=https://lab.billing-easy.net
EBILLING_PORTAL_URL=https://test.billing-easy.net
EBILLING_CLIENT_ID=
EBILLING_CLIENT_SECRET=
EBILLING_TOKEN_URL=
EBILLING_USERNAME=
EBILLING_SHARED_KEY=
EBILLING_WEBHOOK_SECRET=

# DIRECT OPERATOR CREDENTIALS (Optionnel si SHAP est utilisé)
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_API_KEY=
MOOV_MONEY_WEBHOOK_SECRET=

# WALLET MOBILE MONEY LIMITS (Optionnel - valeurs en XAF entiers)
WALLET_MIN_DEPOSIT_XAF=500
WALLET_MAX_DEPOSIT_XAF=2000000
WALLET_MIN_WITHDRAWAL_XAF=1000
WALLET_MAX_WITHDRAWAL_XAF=1000000
WALLET_DAILY_LIMIT_XAF=5000000

